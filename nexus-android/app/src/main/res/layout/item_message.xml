<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <!-- Own Message Bubble (Right) -->
    <LinearLayout
        android:id="@+id/layout_own_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:maxWidth="280dp"
        android:background="@color/nexus_card"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_own_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/nexus_text_main"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tv_own_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/nexus_text_dim"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_own_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" ✓"
                android:textColor="@color/nexus_cyan"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Peer Message Bubble (Left) -->
    <LinearLayout
        android:id="@+id/layout_peer_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:maxWidth="280dp"
        android:background="@color/nexus_surface"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_peer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/nexus_cyan"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tv_peer_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/nexus_text_main"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_peer_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:textColor="@color/nexus_text_dim"
            android:textSize="10sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

</LinearLayout>
