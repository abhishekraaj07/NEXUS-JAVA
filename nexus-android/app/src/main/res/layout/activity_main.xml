<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nexus_bg"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_nexus_shield"
        android:contentDescription="@string/app_name" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/nexus_text_main"
        android:letterSpacing="0.1"
        android:layout_marginTop="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tagline"
        android:textSize="13sp"
        android:textColor="@color/nexus_text_dim"
        android:gravity="center"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="40dp" />

    <Button
        android:id="@+id/btn_create_room"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/create_room"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/nexus_bg"
        android:backgroundTint="@color/nexus_cyan"
        android:letterSpacing="0.05" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/nexus_border"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/et_room_code"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="@string/enter_code"
        android:textColorHint="@color/nexus_text_dim"
        android:textColor="@color/nexus_text_main"
        android:textSize="16sp"
        android:background="@color/nexus_surface"
        android:gravity="center"
        android:inputType="textCapCharacters"
        android:padding="12dp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btn_join_room"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/join_room"
        android:textSize="14sp"
        android:textColor="@color/nexus_text_main"
        android:backgroundTint="@color/nexus_surface" />

</LinearLayout>
